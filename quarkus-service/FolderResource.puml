@startuml
autonumber

actor "Filesystem" as System
participant "FolderWatcher" as FW
participant "NextcloudNativeClient" as NCClient
participant "sync_h (jextract)" as SyncH
participant "libsync.so\n(libcurl/libxml2)" as NativeLib
participant "Nextcloud\n(WebDAV)" as Nextcloud
participant "FolderWatcherLogResource" as Logger

== Datei wird im Watch-Ordner erstellt ==

System -> FW : Datei wird erkannt
FW -> FW : prüfen + filtern
FW -> NCClient : upload(localPath, remoteUrl, user, pass)

NCClient -> SyncH : upload_file(local, remote, user, pass)
SyncH -> NativeLib : libcurl-Aufruf
NativeLib -> Nextcloud : HTTP PUT
Nextcloud --> NativeLib : 201 Created
NativeLib --> SyncH : return code
SyncH --> NCClient : return code
NCClient --> FW : result

alt Upload erfolgreich
  FW -> Logger : incrementUpload(fileName)
else Fehler beim Upload
  FW -> Logger : incrementError("reason")
end

@enduml
